# v2rayn百科 (v2raynwiki.homes) - Apache 静态部署配置
# 适配 VitePress cleanUrls + 目录索引 + Canonical 去尾斜杠 + 真实 404 + 安全与缓存策略

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. 强制 HTTPS（如在反向代理后运行请确认 X-Forwarded-Proto）
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. 统一去除 www 前缀，规范至主域名
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 3. 规范移除显式 /index.html 与冗余 .html 后缀（避免重复收录）
  RewriteCond %{THE_REQUEST} \s/+(.+?)/index\.html[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 4. 目录存在 index.html 时规范补全尾部斜杠（例如 /airport -> /airport/）
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # 5. 非目录单页文档若带多余尾部斜杠，301 规范化为无尾斜杠（与 Canonical 对齐，例如 /reviews/guangsuyun/ -> /reviews/guangsuyun）
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 6. cleanUrls 内部映射：若请求对应 .html 静态文件则直接服务
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)$ /$1.html [L]

  # 7. 不存在的路径严格返回 404，绝不静默重写到首页返回 200
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # 带哈希指纹的 VitePress 构建静态资源长期不可变缓存
  <FilesMatch "\.(js|css|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 图片缓存 30 天
  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML、sitemap、robots、llms.txt 与结构化数据及时校验更新
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
