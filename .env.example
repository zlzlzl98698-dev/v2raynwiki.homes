# ==============================================================================
# Algolia 全文搜索配置（复制本文件为 .env 并填入真实凭证后运行 npm run build:check）
# 留空时自动启用 VitePress 原生本地中文搜索，不影响正常上线使用
# ==============================================================================

# 1. 前端公开检索配置（会安全注入构建后的前端搜索组件）
# 警告：VITE_ALGOLIA_API_KEY 仅允许填写公开的 Search-Only API Key！
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_API_KEY=
VITE_ALGOLIA_INDEX_NAME=v2raynwiki_homes

# 2. 服务端索引同步专用密钥（严禁加 VITE_ 前缀！绝不进入浏览器代码）
# 仅在本地终端执行 `npm run algolia:sync` 推送索引时使用，可不写入文件直接通过命令行传入
# ALGOLIA_ADMIN_KEY=

# ==============================================================================
# 搜索引擎站长验证与 IndexNow 主动推送（可选）
# ==============================================================================
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_SHENMA_SITE_VERIFICATION=
VITE_BAIDU_SITE_VERIFICATION=

# IndexNow 密钥（8–128 位十六进制/字母数字，部署后运行 npm run indexnow:push 主动通知 Bing/ChatGPT Search）
# INDEXNOW_KEY=
